import standard as std
from lib.osc import ClassicSaw
from lib.env import ClassicADSR

# Each press restarts the envelope, including overlapping keys.
Inst.sigstream(std.event.keys.mono(priority: last, retrigger: each_press, glide: 0ms)) as key:
    osc = ClassicSaw.make()
    env = ClassicADSR.make()
    raw = osc(pitch: key.pitch, level: -18db)
    amp = env(gate: key.gate, trigger: key.trigger, retrigger_from: zero,
              A: 10ms, D: 250ms, S: 0.15, R: 100ms)
    return raw * amp * key.velocity
